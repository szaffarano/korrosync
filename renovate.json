{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/Dockerfile/"
      ],
      "matchStrings": [
        "ZIG_VERSION=\"?(?<currentValue>[^\"\\s]+)\"?"
      ],
      "datasourceTemplate": "custom.zig",
      "depNameTemplate": "ziglang/zig",
      "versioningTemplate": "semver-coerced"
    }
  ],
  "customDatasources": {
    "zig": {
      "defaultRegistryUrlTemplate": "https://ziglang.org/download/index.json",
      "format": "json",
      "transformTemplates": [
        "{ \"releases\": $keys($)[$ != \"master\"].{ \"version\": $ } }"
      ]
    }
  }
}
